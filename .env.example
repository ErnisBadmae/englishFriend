# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/english_friend
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/english_friend

# OpenAI
OPENAI_API_KEY=sk-your-api-key-here

# AI Provider: "openai_realtime" (premium ~$1.60/session) or "whisper_pipeline" (budget ~$0.15/session)
AI_PROVIDER=openai_realtime

# OpenAI Realtime settings
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_REALTIME_VOICE=alloy

# Debug
DEBUG=true
