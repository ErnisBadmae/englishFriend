# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/englishfriend_dev

# ======= LLM Provider =======
# vllm | llama_cpp | groq | openai
LLM_PROVIDER=vllm

# vLLM (GPU cluster)
VLLM_BASE_URL=http://192.168.0.18:8000/v1
VLLM_API_KEY=token-abc123
VLLM_MODEL=qwen32b-32k
VLLM_TIMEOUT=60

# llama.cpp (CPU large-context cluster)
LLAMA_CPP_BASE_URL=http://192.168.0.18:8000/v1
LLAMA_CPP_API_KEY=
LLAMA_CPP_MODEL=qwen3.5-35b
LLAMA_CPP_TIMEOUT=120
LLAMA_CPP_RESPONSE_MODE=final_only
LLAMA_CPP_EXTRA_BODY_JSON=

# Groq
GROQ_API_KEY=

# OpenAI fallback + embeddings
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_MEMORY_ENABLED=true

# PersonaPlex (self-hosted speech-to-speech on ai-host-03)
PERSONAPLEX_ENABLED=false
PERSONAPLEX_HOST=192.168.0.18
PERSONAPLEX_PORT=8998
PERSONAPLEX_TIMEOUT=60
PERSONAPLEX_DEFAULT_VOICE=NATM0
PERSONAPLEX_QUANTIZATION=int8

# TTS
TTS_VOICE=american_female

# Pronunciation assessment
# heuristic | azure
PRONUNCIATION_PROVIDER=heuristic
PRONUNCIATION_LOCALE=en-US
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Frontend
VITE_API_URL=http://localhost:8000

# Debug
DEBUG=true
