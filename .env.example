# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/englishfriend_dev
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/englishfriend_dev

# ======= LLM Provider =======
# vllm - свой сервер (по умолчанию, для разработки)
# groq - бесплатно 30 req/min (для демо инвесторам)
# openai - премиум
LLM_PROVIDER=vllm

# vLLM настройки (свой сервер)
VLLM_BASE_URL=http://192.168.0.88:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_TIMEOUT=60

# Groq API (для демо - бесплатно, быстро ~200ms)
# Получить ключ: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI (премиум)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# ======= TTS настройки (edge-tts, бесплатно) =======
# Варианты: american_female, american_male, british_female, british_male, australian_female
TTS_VOICE=american_female

# ======= Legacy настройки (для /stream endpoint) =======
AI_PROVIDER=hume_evi
HUME_API_KEY=
HUME_SECRET_KEY=

# ======= Общие настройки =======
PROXY_URL=
DEBUG=true
